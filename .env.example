# Copy to .env and fill the premium key. .env is gitignored.
# Stub stays the default until TBI_GATEWAY=litellm.

TBI_GATEWAY=litellm

# Local Ollama. No key. Server must be running on 127.0.0.1:11434.
CHEAP_MODEL=ollama/gemma3:4b
MID_MODEL=ollama/llama3.1:8b

# Premium. Direct xAI uses XAI_API_KEY. A model id ending in -stub stays offline.
PREMIUM_MODEL=xai/grok-4.20-non-reasoning
# XAI_API_KEY=

# Other premium options. Set one model id and its key, then restart.
# PREMIUM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=
# PREMIUM_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# PREMIUM_MODEL=openrouter/x-ai/grok-4
# OPENROUTER_API_KEY=

# Atlassian read client. Unset means fixtures only. No MCP call from the router.
# ATLASSIAN_SITE=https://your-site.atlassian.net
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
